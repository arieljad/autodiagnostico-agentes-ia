# Puerto del backend (en desarrollo, Vite le pasa /api a este puerto)
PORT=3001
# Postgres. Si no se define, las respuestas se guardan en data/respuestas.json
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# PGSSL=false
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Link para agendar la reunión (Microsoft Bookings, Calendly, etc.) en la pantalla de resultado.
# Si no se define, el botón abre un correo a contacto@paradigma.com con el asunto armado.
# VITE_AGENDA_URL=https://outlook.office.com/bookwithme/...
